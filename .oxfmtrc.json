{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 120,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "none",
  "semi": false,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/.vscode/",
    "**/.docusaurus/",
    "**/coverage",
    "**/dist/",
    "**/lib/",
    "**/node_modules/",
    "**/Dockerfile",
    "**/sandboxes/*/build/**",
    "**/playwright-report/**",
    "**/packages/docs/.next/**/*",
    "**/pnpm-lock.yaml",
    "**/*.mdx",
    "**/*.webmanifest",
    "**/*.png",
    "**/*.svg",
    "**/*.xml",
    "**/*.ico",
    "packages/tokenizers"
  ]
}
