# R2 S3-compatible API credentials for edge-index-builder
R2_BUCKET=zbsearch-edge
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# Optional Worker auth (also set via wrangler secret)
API_KEY=

# Rebuild trigger threshold (Worker var in wrangler.toml)
REBUILD_THRESHOLD_OPS=500

# Optional: webhook for external rebuild runner (GitHub Actions, Docker)
BUILDER_WEBHOOK_URL=
