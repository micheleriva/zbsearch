{
  "name": "@zbsearch/docs-index",
  "version": "4.0.0",
  "description": "Turns documentation sources into a ZBSearch index, and queries it in the browser",
  "keywords": [
    "documentation",
    "index",
    "markdown",
    "search",
    "zbsearch"
  ],
  "homepage": "https://github.com/micheleriva/zbsearch#readme",
  "bugs": {
    "url": "https://github.com/micheleriva/zbsearch/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Michele Riva",
    "email": "riva.michele.95@gmail.com",
    "url": "https://github.com/MicheleRiva"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micheleriva/zbsearch.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/rolldown-build.mjs && tsc -p . --emitDeclarationOnly",
    "lint": "oxlint --fix --fix-suggestions",
    "test": "vitest run"
  },
  "dependencies": {
    "@zbsearch/searchbox-core": "workspace:*",
    "acorn": "^8.18.0",
    "github-slugger": "^2.0.0",
    "mdast-util-directive": "^3.1.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-mdxjs-esm": "^2.0.1",
    "micromark-extension-directive": "^4.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-mdxjs": "^3.0.0",
    "micromark-extension-mdxjs-esm": "^3.0.0",
    "yaml": "^2.9.0",
    "zbsearch": "workspace:*"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.7.0",
    "rolldown": "^1.2.3",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  }
}
