{
  "name": "@zbsearch/docs-index",
  "version": "3.3.4",
  "description": "Turns documentation sources into a ZBSearch index, and queries it in the browser",
  "keywords": [
    "zbsearch",
    "search",
    "documentation",
    "index",
    "markdown"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "bugs": {
    "url": "https://github.com/micheleriva/zbsearch/issues"
  },
  "homepage": "https://github.com/micheleriva/zbsearch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micheleriva/zbsearch.git"
  },
  "scripts": {
    "build": "tsup --config tsup.lib.js && tsc -p . --emitDeclarationOnly",
    "lint": "exit 0",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zbsearch/searchbox-core": "workspace:*",
    "github-slugger": "^2.0.0",
    "zbsearch": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  },
  "author": {
    "name": "Michele Riva",
    "email": "riva.michele.95@gmail.com",
    "url": "https://github.com/MicheleRiva"
  }
}
