{
  "name": "@zbsearch/edge-core",
  "version": "3.3.4",
  "description": "Cloud-agnostic edge search index core - manifest, buffer, REST handlers",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "swc --delete-dir-on-start --extensions .ts -d dist src && tsc -p . --emitDeclarationOnly",
    "test": "node --import tsx --test tests/**/*.test.ts"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@msgpack/msgpack": "^3.1.2",
    "zbsearch": "workspace:*"
  },
  "devDependencies": {
    "@swc/cli": "^0.1.59",
    "@swc/core": "^1.3.27",
    "@types/node": "^20.19.43",
    "tsx": "^4.20.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
