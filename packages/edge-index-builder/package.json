{
  "name": "@zbsearch/edge-index-builder",
  "version": "3.3.4",
  "description": "Rebuild and bulk-import CLI for ZBSearch Edge indexes",
  "license": "Apache-2.0",
  "bin": {
    "zbsearch-edge-builder": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/oxc-build.mjs && tsc -p . --emitDeclarationOnly",
    "rebuild": "node dist/cli.js rebuild",
    "test": "vitest run",
    "lint": "oxlint --fix --fix-suggestions"
  },
  "dependencies": {
    "@zbsearch/edge-core": "workspace:*",
    "@zbsearch/storage-s3": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "oxc-transform": "^0.143.0",
    "tsx": "^4.20.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
