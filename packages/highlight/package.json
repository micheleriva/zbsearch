{
  "name": "@zbsearch/highlight",
  "version": "3.3.4",
  "description": "Highlight and trim search matches inside a text",
  "keywords": [
    "zbsearch",
    "highlight",
    "search",
    "snippet",
    "excerpt"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "bugs": {
    "url": "https://github.com/micheleriva/zbsearch/issues"
  },
  "homepage": "https://github.com/micheleriva/zbsearch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micheleriva/zbsearch.git"
  },
  "scripts": {
    "build": "tsup --config tsup.lib.js && tsc -p . --emitDeclarationOnly",
    "lint": "exit 0",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  },
  "author": {
    "name": "Michele Riva",
    "email": "riva.michele.95@gmail.com",
    "url": "https://github.com/MicheleRiva"
  }
}
