{
  "name": "@zbsearch/highlight",
  "version": "4.0.0",
  "description": "Highlight and trim search matches inside a text",
  "keywords": [
    "excerpt",
    "highlight",
    "search",
    "snippet",
    "zbsearch"
  ],
  "homepage": "https://github.com/micheleriva/zbsearch#readme",
  "bugs": {
    "url": "https://github.com/micheleriva/zbsearch/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Michele Riva",
    "email": "riva.michele.95@gmail.com",
    "url": "https://github.com/MicheleRiva"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micheleriva/zbsearch.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/rolldown-build.mjs && tsc -p . --emitDeclarationOnly",
    "lint": "oxlint --fix --fix-suggestions",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "rolldown": "^1.2.3",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  }
}
