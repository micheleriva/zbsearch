{
  "name": "@zbsearch/plugin-data-persistence",
  "version": "4.0.0",
  "description": "Data persistence plugin for ZBSearch",
  "keywords": [
    "disk persistence",
    "full-text search",
    "zbsearch"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Michele Riva",
    "email": "michele@zbsearch.com",
    "url": "https://github.com/MicheleRiva"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/commonjs.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/commonjs.cjs",
      "node": "./dist/commonjs.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server-commonjs.cjs",
      "node": "./dist/server-commonjs.cjs"
    },
    "./indexeddb": {
      "types": "./dist/indexeddb.d.ts",
      "import": "./dist/indexeddb.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "swc --delete-dir-on-start -s -w --extensions .ts,.cts -d dist src",
    "build": "node ../../scripts/mixed-build.mjs",
    "test": "vitest run",
    "benchmark": "tsx benchmark/index.ts",
    "lint": "oxlint --fix --fix-suggestions"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.2",
    "dpack": "^0.6.22",
    "seqproto": "^0.2.3",
    "zbsearch": "workspace:*"
  },
  "devDependencies": {
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.47",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "benny": "^3.7.1",
    "fake-indexeddb": "^6.2.5",
    "msgpack": "link:@types/msgpack/msgpack",
    "oxc-transform": "^0.143.0",
    "readable-stream": "^4.3.0",
    "tsx": "^4.20.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@7.0.2"
  }
}
