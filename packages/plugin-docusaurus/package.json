{
  "name": "@zbsearch/plugin-docusaurus",
  "version": "4.0.0",
  "description": "Make ZBSearch the default search engine of your Docusaurus site",
  "keywords": [
    "docusaurus",
    "docusaurus-plugin",
    "docusaurus-theme",
    "full-text search",
    "search",
    "zbsearch"
  ],
  "homepage": "https://github.com/micheleriva/zbsearch#readme",
  "bugs": {
    "url": "https://github.com/micheleriva/zbsearch/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Michele Riva",
    "email": "riva.michele.95@gmail.com",
    "url": "https://github.com/MicheleRiva"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micheleriva/zbsearch.git"
  },
  "files": [
    "lib",
    "src/theme"
  ],
  "type": "module",
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "import": "./lib/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p . --emitDeclarationOnly",
    "lint": "oxlint --fix --fix-suggestions",
    "test": "vitest run"
  },
  "dependencies": {
    "@zbsearch/docs-index": "workspace:*",
    "@zbsearch/searchbox-react": "workspace:*",
    "zbsearch": "workspace:*"
  },
  "devDependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "oxc-transform": "^0.143.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rolldown": "^1.2.3",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@docusaurus/core": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
