{
  "name": "@zbsearch/plugin-parsedoc",
  "version": "3.3.4",
  "description": "ZBSearch plugin to populate an index with HTML/Markdown documents",
  "keywords": [],
  "homepage": "https://github.com/micheleriva/zbsearch#readme",
  "bugs": {
    "url": "https://github.com/oramasearch/orama/issues"
  },
  "license": "Apache-2.0",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micheleriva/zbsearch.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/commonjs.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/commonjs.cjs"
    }
  },
  "scripts": {
    "dev": "swc --delete-dir-on-start -s -w --extensions .ts,.cts -d dist src",
    "build": "node ../../scripts/mixed-build.mjs",
    "test": "vitest run",
    "lint": "oxlint --fix --fix-suggestions"
  },
  "dependencies": {
    "glob": "^8.1.0",
    "hast-util-from-html": "^1.0.1",
    "hast-util-from-string": "^2.0.0",
    "hast-util-to-html": "^8.0.4",
    "hast-util-to-string": "^2.0.0",
    "rehype": "^12.0.1",
    "rehype-document": "^6.1.0",
    "rehype-parse": "^8.0.4",
    "rehype-preset-minify": "^6.0.0",
    "remark-parse": "^10.0.1",
    "remark-rehype": "^10.1.0",
    "unified": "^10.1.2",
    "zbsearch": "workspace:*"
  },
  "devDependencies": {
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.47",
    "@types/glob": "^8.0.1",
    "@types/hast": "^2.3.4",
    "@types/node": "^20.9.0",
    "oxc-transform": "^0.143.0",
    "tsx": "^3.12.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@7.0.2"
  }
}
