{
  "name": "@zbsearch/searchbox-react",
  "version": "3.3.4",
  "description": "Accessible, unstyled-by-default React search box UI for ZBSearch",
  "keywords": [
    "autocomplete",
    "command palette",
    "react",
    "search",
    "searchbox",
    "zbsearch"
  ],
  "homepage": "https://github.com/micheleriva/zbsearch#readme",
  "bugs": {
    "url": "https://github.com/micheleriva/zbsearch/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Michele Riva",
    "email": "riva.michele.95@gmail.com",
    "url": "https://github.com/MicheleRiva"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micheleriva/zbsearch.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/rolldown-build.mjs && tsc -p . --emitDeclarationOnly",
    "lint": "oxlint --fix --fix-suggestions",
    "test": "vitest run"
  },
  "dependencies": {
    "@zbsearch/searchbox-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^28.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rolldown": "^1.2.3",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
