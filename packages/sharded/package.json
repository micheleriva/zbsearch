{
  "name": "@zbsearch/sharded",
  "version": "4.0.2",
  "description": "Sharded, lazily-loaded runtime ZBSearch databases with full-text, vector and hybrid search under a memory budget",
  "keywords": [
    "full-text search",
    "hybrid search",
    "indexeddb",
    "lazy loading",
    "search",
    "sharding",
    "vector search",
    "zbsearch"
  ],
  "homepage": "https://github.com/micheleriva/zbsearch#readme",
  "bugs": {
    "url": "https://github.com/micheleriva/zbsearch/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Michele Riva",
    "email": "riva.michele.95@gmail.com",
    "url": "https://github.com/MicheleRiva"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micheleriva/zbsearch.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/rolldown-build.mjs && tsc -p . --emitDeclarationOnly",
    "lint": "oxlint --fix --fix-suggestions",
    "test": "vitest run",
    "test:types": "tsc -p tsconfig.test.json",
    "prepublishOnly": "node ../../scripts/check-publish.mjs"
  },
  "dependencies": {
    "zbsearch": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@zbsearch/edge-core": "workspace:*",
    "fake-indexeddb": "^6.2.5",
    "rolldown": "^1.2.3",
    "typescript": "^7.0.2"
  }
}
