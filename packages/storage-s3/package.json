{
  "name": "@zbsearch/storage-s3",
  "version": "3.3.4",
  "description": "S3-compatible object storage driver for ZBSearch Edge (AWS S3, R2, MinIO)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/oxc-build.mjs && tsc -p . --emitDeclarationOnly",
    "test": "vitest run"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@zbsearch/edge-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@zbsearch/plugin-data-persistence": "workspace:*",
    "oxc-transform": "^0.143.0",
    "tsx": "^4.20.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "zbsearch": "workspace:*"
  }
}
