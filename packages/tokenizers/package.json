{
  "name": "@zbsearch/tokenizers",
  "version": "4.0.0",
  "type": "module",
  "description": "Additional tokenizers for ZBSearch",
  "sideEffects": false,
  "exports": {
    "./japanese": {
      "import": {
        "types": "./dist/esm/japanese.d.ts",
        "default": "./dist/esm/japanese.js"
      },
      "require": {
        "types": "./dist/commonjs/japanese.d.ts",
        "default": "./dist/commonjs/japanese.js"
      }
    },
    "./mandarin": {
      "import": {
        "types": "./dist/esm/mandarin.d.ts",
        "default": "./dist/esm/mandarin.js"
      },
      "require": {
        "types": "./dist/commonjs/mandarin.d.ts",
        "default": "./dist/commonjs/mandarin.js"
      }
    },
    "./korean": {
      "import": {
        "types": "./dist/esm/korean.d.ts",
        "default": "./dist/esm/korean.js"
      },
      "require": {
        "types": "./dist/commonjs/korean.d.ts",
        "default": "./dist/commonjs/korean.js"
      }
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "zbsearch": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/micheleriva/zbsearch"
  },
  "bugs": {
    "url": "https://github.com/micheleriva/zbsearch"
  },
  "scripts": {
    "build": "node ../../scripts/dialects-build.mjs",
    "test": "vitest run",
    "lint": "oxlint --fix --fix-suggestions"
  },
  "keywords": [
    "full-text search",
    "search",
    "fuzzy search",
    "typo-tolerant search",
    "full-text",
    "vector search",
    "stemming",
    "tokenizers",
    "mandarin",
    "chinese",
    "korean"
  ],
  "author": {
    "name": "Michele Riva",
    "email": "riva.michele.95@gmail.com",
    "url": "https://github.com/MicheleRiva",
    "author": true
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">= 20.0.0"
  },
  "devDependencies": {
    "oxc-transform": "^0.143.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
