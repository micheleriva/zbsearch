{
  "name": "zbsearch",
  "version": "4.0.0",
  "description": "A complete search engine in your browser, server, or edge network with support for full-text, vector, and hybrid search in less than 2kb.",
  "keywords": [
    "full-text",
    "full-text search",
    "fuzzy search",
    "search",
    "typo-tolerant search",
    "vector database",
    "vector search",
    "vectors"
  ],
  "bugs": {
    "url": "https://github.com/micheleriva/zbsearch"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Michele Riva",
    "email": "riva.michele.95@gmail.com",
    "url": "https://github.com/MicheleRiva",
    "author": true
  },
  "contributors": [
    {
      "name": "Tommaso Allevi",
      "url": "https://github.com/allevo"
    },
    {
      "name": "Paolo Insogna",
      "url": "http://cowtech.it",
      "author": true
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/micheleriva/zbsearch"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/commonjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "deno": {
        "types": "./dist/deno/index.d.ts",
        "default": "./dist/deno/index.js"
      },
      "browser": {
        "types": "./dist/browser/index.d.ts",
        "default": "./dist/browser/index.js"
      },
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./internals": {
      "deno": {
        "types": "./dist/deno/internals.d.ts",
        "default": "./dist/deno/internals.js"
      },
      "browser": {
        "types": "./dist/browser/internals.d.ts",
        "default": "./dist/browser/internals.js"
      },
      "import": {
        "types": "./dist/esm/internals.d.ts",
        "default": "./dist/esm/internals.js"
      },
      "require": {
        "types": "./dist/commonjs/internals.d.ts",
        "default": "./dist/commonjs/internals.js"
      }
    },
    "./components": {
      "deno": {
        "types": "./dist/deno/components.d.ts",
        "default": "./dist/deno/components.js"
      },
      "browser": {
        "types": "./dist/browser/components.d.ts",
        "default": "./dist/browser/components.js"
      },
      "import": {
        "types": "./dist/esm/components.d.ts",
        "default": "./dist/esm/components.js"
      },
      "require": {
        "types": "./dist/commonjs/components.d.ts",
        "default": "./dist/commonjs/components.js"
      }
    },
    "./trees": {
      "deno": {
        "types": "./dist/deno/trees.d.ts",
        "default": "./dist/deno/trees.js"
      },
      "browser": {
        "types": "./dist/browser/trees.d.ts",
        "default": "./dist/browser/trees.js"
      },
      "import": {
        "types": "./dist/esm/trees.d.ts",
        "default": "./dist/esm/trees.js"
      },
      "require": {
        "types": "./dist/commonjs/trees.d.ts",
        "default": "./dist/commonjs/trees.js"
      }
    },
    "./trees/vector-ivf": {
      "deno": {
        "types": "./dist/deno/trees/vector-ivf.d.ts",
        "default": "./dist/deno/trees/vector-ivf.js"
      },
      "browser": {
        "types": "./dist/browser/trees/vector-ivf.d.ts",
        "default": "./dist/browser/trees/vector-ivf.js"
      },
      "import": {
        "types": "./dist/esm/trees/vector-ivf.d.ts",
        "default": "./dist/esm/trees/vector-ivf.js"
      },
      "require": {
        "types": "./dist/commonjs/trees/vector-ivf.d.ts",
        "default": "./dist/commonjs/trees/vector-ivf.js"
      }
    }
  },
  "scripts": {
    "benchmark": "node ../../benchmarks/index.js",
    "predev": "rm -rf dist && mkdir dist",
    "dev": "swc -s -w --extensions .ts,.cts -d dist src",
    "prebuild": "cp ../../README.md ./README.md",
    "build": "node ../../scripts/dialects-build.mjs --esm-target esnext --copies browser,deno",
    "lint": "oxlint --fix --fix-suggestions",
    "test": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "test:types": "vitest run --typecheck --config vitest.types.config.ts",
    "ci": "npm run build && npm run test:ci && npm run test:types"
  },
  "devDependencies": {
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.47",
    "@types/node": "^20.9.0",
    "@zbsearch/stemmers": "workspace:*",
    "@zbsearch/stopwords": "workspace:*",
    "auto-changelog": "^2.4.0",
    "esbuild": "^0.28.1",
    "glob": "^9.2.3",
    "oxc-transform": "^0.143.0",
    "resolve-import": "^2.4.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">= 20.0.0"
  }
}
