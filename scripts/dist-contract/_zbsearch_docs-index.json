{
  "name": "@zbsearch/docs-index",
  "files": [
    "dist/build.d.ts",
    "dist/client.d.ts",
    "dist/index.cjs",
    "dist/index.cjs.map",
    "dist/index.d.ts",
    "dist/index.js",
    "dist/index.js.map",
    "dist/markdown.d.ts",
    "dist/node.cjs",
