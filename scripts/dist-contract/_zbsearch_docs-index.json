    ],
    "dist/client.d.ts": [
      "LoadedIndex",
      "SearcherOptions",
      "assertPayloadVersion",
      "createIndexLoader",
      "createSearcher",
      "hydrateIndex"
    ],
    "dist/index.d.ts": [
      "DEFAULT_BOOST",
      "HIERARCHY_SEPARATOR",
      "LoadedIndex",
      "PAYLOAD_VERSION",
      "RECORD_SCHEMA",
      "SEARCHABLE_PROPERTIES",
      "SearchBoost",
      "SearchIndexPayload",
      "SearchRecord",
      "SearchRuntimeOptions",
      "SearcherOptions",
      "assertPayloadVersion",
      "createIndexLoader",
      "createSearcher",
      "hydrateIndex"
    ],
    "dist/markdown.d.ts": [
      "MarkdownDialect",
      "MarkdownSection",
      "ParseMarkdownOptions",
      "ParsedMarkdown",
      "dialectOf",
      "parseMarkdown",
      "stripInlineMarkup"
    ],
    "dist/node.d.ts": [
      "MarkdownDialect",
      "MarkdownSection",
      "ParseMarkdownOptions",
      "ParsedMarkdown",
      "buildIndex",
      "dialectOf",
      "parseMarkdown",
      "stripInlineMarkup"
    ],
    "dist/records.d.ts": [
      "DEFAULT_BOOST",
      "HIERARCHY_SEPARATOR",
      "PAYLOAD_VERSION",
      "RECORD_SCHEMA",
      "SEARCHABLE_PROPERTIES",
      "SearchBoost",
      "SearchIndexPayload",
      "SearchRecord",
      "SearchRuntimeOptions"
    ]
  },
  "targets": [
    {
      "condition": "..import",
      "target": "./dist/index.js",
      "exists": true
    },
    {
      "condition": "..require",
      "target": "./dist/index.cjs",
      "exists": true
    },
    {
      "condition": "..types",
      "target": "./dist/index.d.ts",
      "exists": true
    },
    {
      "condition": "./node.import",
      "target": "./dist/node.js",
      "exists": true
    },
    {
      "condition": "./node.require",
      "target": "./dist/node.cjs",
      "exists": true
    },
    {
      "condition": "./node.types",
      "target": "./dist/node.d.ts",
      "exists": true
    },
    {
      "condition": "./package.json",
      "target": "./package.json",
      "exists": true
    },
    {
      "condition": "#main",
      "target": "./dist/index.cjs",
      "exists": true
    },
    {
      "condition": "#module",
      "target": "./dist/index.js",
      "exists": true
    },
    {
      "condition": "#types",
      "target": "./dist/index.d.ts",
      "exists": true
    }
  ],
  "markers": {}
}
