{
  "name": "@zbsearch/edge-index-builder",
  "files": [
    "dist/cli.d.ts",
    "dist/cli.d.ts.map",
    "dist/cli.js",
    "dist/import-documents.d.ts",
    "dist/import-documents.d.ts.map",
    "dist/import-documents.js",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/index.js"
  ],
  "types": {
    "dist/cli.d.ts": [],
    "dist/import-documents.d.ts": [
      "assignDocIds",
      "loadImportDocuments",
      "slugifyDocId"
    ],
    "dist/index.d.ts": [
      "rebuildIndex"
    ]
  },
  "targets": [
    {
      "condition": "..import",
      "target": "./dist/index.js",
      "exists": true
    },
    {
      "condition": "..types",
      "target": "./dist/index.d.ts",
      "exists": true
    },
    {
      "condition": "#main",
      "target": "./dist/index.js",
      "exists": true
    },
    {
      "condition": "#types",
      "target": "./dist/index.d.ts",
      "exists": true
    }
  ],
  "markers": {}
}
