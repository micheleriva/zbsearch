    ],
    "lib/theme/SearchBar/index.d.ts": [
      "SearchBar",
      "default"
    ]
  },
  "targets": [
    {
      "condition": "..import",
      "target": "./lib/index.js",
      "exists": true
    },
    {
      "condition": "..require",
      "target": "./lib/index.cjs",
      "exists": true
