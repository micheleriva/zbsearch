    "lib/node/collect.d.ts": [
      "AllContent",
      "CollectResult",
      "SourceDocument",
      "collectRecords",
      "collectSourceDocuments",
      "readRecords",
      "resolveSourcePath"
    ],
    "lib/node/options.d.ts": [
      "CategoryLabels",
      "ResolvedOptions",
      "ZBSearchDocusaurusOptions",
      "createRouteFilter",
      "resolveOptions"
    ],
    "lib/shared/index.d.ts": [
      "GENERATED_DIR",
      "PAYLOAD_FILE",
      "PLUGIN_NAME",
