    "lib/index.cjs",
    "lib/index.cjs.map",
    "lib/index.d.ts",
    "lib/index.js",
    "lib/index.js.map",
    "lib/node/build-index.d.ts",
    "lib/node/collect.d.ts",
    "lib/node/options.d.ts",
    "lib/shared/index.d.ts",
    "lib/shared/index.js",
    "lib/shared/index.js.map",
    "lib/theme/SearchBar/index.d.ts",
    "lib/theme/SearchBar/index.js",
    "lib/theme/SearchBar/index.js.map",
