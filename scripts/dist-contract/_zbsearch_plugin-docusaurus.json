      "target": "./lib/client/index.js",
      "exists": true
    },
    {
      "condition": "./client.types",
      "target": "./lib/client/index.d.ts",
      "exists": true
    },
    {
      "condition": "./package.json",
      "target": "./package.json",
      "exists": true
    },
    {
      "condition": "#main",
      "target": "./lib/index.cjs",
      "exists": true
    },
    {
      "condition": "#module",
      "target": "./lib/index.js",
      "exists": true
    },
    {
      "condition": "#types",
      "target": "./lib/index.d.ts",
      "exists": true
    }
