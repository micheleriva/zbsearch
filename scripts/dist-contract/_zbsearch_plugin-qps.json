{
  "name": "@zbsearch/plugin-qps",
  "files": [
    "dist/algorithm.d.ts",
    "dist/index.cjs",
    "dist/index.cjs.map",
    "dist/index.d.ts",
    "dist/index.global.js",
    "dist/index.global.js.map",
    "dist/index.js",
    "dist/index.js.map"
  ],
  "types": {
    "dist/algorithm.d.ts": [
      "QPSIndex",
      "bitmask_20",
      "calculateTokenQuantum",
      "count",
      "insertString",
      "numberOfOnes",
      "recursiveCreate",
      "removeString",
      "searchString"
    ],
    "dist/index.d.ts": [
      "pluginQPS"
    ]
  },
  "targets": [
    {
      "condition": "..browser",
      "target": "./dist/index.global.js",
      "exists": true
    },
    {
      "condition": "..import",
      "target": "./dist/index.js",
      "exists": true
    },
    {
      "condition": "..require",
      "target": "./dist/index.cjs",
      "exists": true
    },
    {
      "condition": "..types",
      "target": "./dist/index.d.ts",
      "exists": true
    },
    {
      "condition": "#main",
      "target": "./dist/index.js",
      "exists": true
    },
    {
      "condition": "#types",
      "target": "./dist/index.d.ts",
      "exists": true
    }
  ],
  "markers": {}
}
