{
  "name": "@zbsearch/plugin-vitepress",
  "files": [
    "dist/collect.d.ts",
    "dist/index.cjs",
    "dist/index.cjs.map",
    "dist/index.d.ts",
    "dist/index.js",
    "dist/index.js.map",
    "dist/options.d.ts"
  ],
  "types": {
    "dist/collect.d.ts": [
      "ContentEntry",
      "collectRecords",
      "withBase"
    ],
    "dist/index.d.ts": [
      "INDEX_FILE",
      "SearchRecord",
      "ZBSearchVitePressOptions",
      "default",
      "zbsearchVitePress"
    ],
    "dist/options.d.ts": [
      "ResolvedOptions",
      "VirtualOptions",
      "ZBSearchVitePressOptions",
      "createRouteFilter",
      "resolveOptions"
    ]
  },
  "targets": [
    {
      "condition": "..import",
      "target": "./dist/index.js",
      "exists": true
    },
    {
      "condition": "..require",
      "target": "./dist/index.cjs",
      "exists": true
    },
    {
      "condition": "..types",
      "target": "./dist/index.d.ts",
      "exists": true
    },
    {
      "condition": "./package.json",
      "target": "./package.json",
      "exists": true
    },
    {
      "condition": "./SearchBox.vue",
      "target": "./src/theme/SearchBox.vue",
      "exists": true
    },
    {
      "condition": "./theme",
      "target": "./src/theme/index.ts",
      "exists": true
    },
    {
      "condition": "#main",
      "target": "./dist/index.cjs",
      "exists": true
    },
    {
      "condition": "#module",
      "target": "./dist/index.js",
      "exists": true
    },
    {
      "condition": "#types",
      "target": "./dist/index.d.ts",
      "exists": true
    }
  ],
  "markers": {}
}
