{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["packages/**/*.test.js", "packages/**/*.test.jsx", "packages/**/*.test.ts", "packages/**/*.test.tsx"]
    },
    "lint": {},
    "deploy": {
      "dependsOn": ["^lint", "^build", "^test"]
    },
    "zbsearch#build": {
      "dependsOn": ["@zbsearch/stemmers#build", "^build"],
      "outputs": ["dist/**"]
    },
    "@zbsearch/plugin-match-highlight#build": {
      "dependsOn": ["zbsearch#build", "^build"],
      "outputs": ["dist/**"]
    },
    "@zbsearch/plugin-parsedoc#build": {
      "dependsOn": ["zbsearch#build", "^build"],
      "outputs": ["dist/**"]
    },
    "@zbsearch/plugin-astro#build": {
      "dependsOn": ["zbsearch#build", "^build"],
      "outputs": ["dist/**"]
    },
    "@zbsearch/plugin-nextra#build": {
      "dependsOn": ["zbsearch#build", "@zbsearch/plugin-match-highlight#build", "^build"],
      "outputs": ["dist/**"]
    },
    "@zbsearch/plugin-embeddings#build": {
      "dependsOn": ["zbsearch#build"],
      "outputs": ["dist/**"]
    },
    "@zbsearch/plugin-pt15#build": {
      "dependsOn": ["zbsearch#build"],
      "outputs": ["dist/**"]
    },
    "@zbsearch/tokenizers#build": {
      "dependsOn": ["zbsearch#build"]
    },
    "@zbsearch/docs#build": {
      "dependsOn": ["zbsearch#build"],
      "outputs": [".next/**", "!.next/cache/**"]
    }
  }
}
